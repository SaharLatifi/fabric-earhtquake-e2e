	measure '_number of earhquakes' = COUNTX(fact_earthquake , fact_earthquake[event_date])
		formatString: 0
		displayFolder: _measures
		lineageTag: df92bb9c-dc71-434d-9391-a332b3784520

		changedProperty = Name

		changedProperty = DisplayFolder

	measure '_average mag' = AVERAGEX(fact_earthquake, fact_earthquake[mag])
