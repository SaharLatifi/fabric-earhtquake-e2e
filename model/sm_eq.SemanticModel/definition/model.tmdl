model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DirectLake - wh_earthquake"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["RemoteModeling","DirectLakeOnOneLakeCreatedInDesktop"]

ref table dim_country
ref table dim_date
ref table fact_earthquake
ref table dim_mag_category
ref table dim_sig_category
ref table dim_depth_category

